# User-level systemd unit for the Go discovery daemon itself.
# Installed by install.sh as `meteora-dlmm-trading-bot.service` (rewrites
# __REPO__ to the checkout path). Reads all config from $REPO/.env — the same
# file you would `set -a && . ./.env` before running ./mdtb by hand.
#
# Ordered after the Hermes gateway (__GATEWAY__ = hermes-gateway-<profile>.service,
# derived from the install target) because webhook mode posts to it; in
# direct-deploy mode (DEPLOY_CMD set) the dependency is a harmless weak Wants=.
[Unit]
Description=Meteora DLMM Trading Bot (pool discovery -> Hermes webhook / direct deploy)
After=network-online.target __GATEWAY__
Wants=network-online.target __GATEWAY__

[Service]
Type=simple
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/.env
ExecStart=__REPO__/mdtb
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
