# Optional. install.sh renders __PROFILE__ into <profile>/systemd/; copy from there.
[Unit]
Description=Azimuth conservative empty token account rent recovery

[Service]
Type=oneshot
ExecStart=/usr/bin/node __PROFILE__/skills/solana-dlmm/scripts/dlmm_executor.js reclaim-empty-accounts --execute --batch
TimeoutStartSec=120
UMask=0077
# No immediate retries: ambiguous sends are reconciled by the executor next run.
