[Unit]
Description=Azimuth operational dashboard (local read-only evidence)

[Service]
Type=simple
WorkingDirectory=__REPO__
ExecStart=%h/.local/bin/azimuth-dashboard -env-file __REPO__/.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
# Soft cap: above it the kernel reclaims and throttles (journal page cache first) instead of
# letting a refresh push the host into OOM. Steady state is ~80MB server + ~70MB collector.
MemoryHigh=384M

[Install]
WantedBy=default.target
