#!/usr/bin/env bash
# Enforce Conventional Commits subject + a bulleted, <=100-char body.
# Installed locally (not tracked by git) — lives only in .git/hooks.
set -euo pipefail

msg_file="$1"
subject="$(head -n1 "$msg_file")"

# Merge/revert commits are machine-generated by git itself — exempt.
if [[ "$subject" =~ ^Merge\  ]] || [[ "$subject" =~ ^Revert\ \" ]]; then
  exit 0
fi

types="feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert"

if ! [[ "$subject" =~ ^(${types})(\([a-zA-Z0-9/_.-]+\))?!?:\ .+ ]]; then
  echo "✖ commit-msg: subject must be Conventional Commits format:" >&2
  echo "    <type>(<scope>): <description>   e.g. fix(scanner): stop X" >&2
  echo "  allowed types: ${types//|/, }" >&2
  echo "  got: $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 100 ]; then
  echo "✖ commit-msg: subject line exceeds 100 chars (${#subject}): $subject" >&2
  exit 1
fi

fail=0
line_no=0
while IFS= read -r line || [ -n "$line" ]; do
  line_no=$((line_no + 1))
  [ "$line_no" -le 2 ] && continue                 # subject + blank separator
  [ -z "$line" ] && continue                        # blank spacer lines
  [[ "$line" =~ ^Co-Authored-By: ]] && continue      # trailer, exempt
  [[ "$line" =~ ^#  ]] && continue                   # git comment lines

  if [ "${#line}" -gt 100 ]; then
    echo "✖ commit-msg: body line exceeds 100 chars (${#line}):" >&2
    echo "    $line" >&2
    fail=1
  fi
  if ! [[ "$line" =~ ^[-*]\  ]]; then
    echo "✖ commit-msg: body line must be a bullet ('- ' or '* '):" >&2
    echo "    $line" >&2
    fail=1
  fi
done < "$msg_file"

exit "$fail"
