# ─── Meteora discovery ───────────────────────────────────────────────
# Base pool-discovery endpoint (rarely needs changing).
METEORA_DISCOVER_URL=https://pool-discovery-api.datapi.meteora.ag/pools
# How often to poll each enabled timeframe.
POLL_INTERVAL=60s

# ─── Hermes webhook sink ─────────────────────────────────────────────
# Where qualifying pools are POSTed. Must match your Hermes profile's
# webhook host/port + the subscription path (see assets/hermes/).
HERMES_WEBHOOK_URL=http://127.0.0.1:8646/webhooks/dlmm-signal
# Shared HMAC secret. MUST match the `secret` in webhook_subscriptions.json.
HERMES_WEBHOOK_SECRET=dlmm-signal-secret-change-me

# ─── Dedup store ─────────────────────────────────────────────────────
# Leave REDIS_ADDR empty for in-memory dedup (single instance). Set to a
# host:port to share the seen-set across restarts / instances.
REDIS_ADDR=
REDIS_SEEN_KEY=dlmm:signal:seen_pools
# Rolling window a pool stays "seen" (won't re-signal) after first emit.
SEEN_TTL=24h
# Turnover-mode override of SEEN_TTL: fast-cycle positions live minutes, so a
# still-qualifying pool may re-signal sooner (cooldowns still gate re-entry).
TURNOVER_SEEN_TTL=2h
# Casual-mode override of SEEN_TTL: positions live ~30m-2h and the monitor's
# close cooldown lapses in 1-2h, so a proven pool may re-signal the same day
# instead of being silenced for the full 24h (cooldowns still gate re-entry).
CASUAL_SEEN_TTL=6h
# Pulse-mode override of SEEN_TTL: it polls a 5m discovery window, so its
# pools churn even faster than turnover's and must be able to re-signal.
PULSE_SEEN_TTL=2h

# ─── Mode toggles ────────────────────────────────────────────────────
ENABLE_CASUAL=true
ENABLE_MULTIDAY=true
# Turnover: small pools ($5k-$300k TVL) with 1%+ base fee turning TVL over
# fast — fee-capture plays where yield isn't capped by the trailing TP.
# Experimental; off by default until proven live (see internal/meteora/screen.go).
ENABLE_TURNOVER=false
# Pulse: a port of the reference bot's own screen — the SAME TVL/mcap/holder
# band as turnover, but sampled through a 5m trending window instead of a 30m
# fee-sorted one, and without the base-fee / turnover / swap-count gates. The
# two windows surface largely disjoint pools, so running both makes the entry
# set the union of the screens rather than turnover's slice of it. Costs one
# extra discovery call per poll.
ENABLE_PULSE=false
# Fetch DexScreener momentum to reject dumping/downtrending tokens before
# emitting. Best-effort; fails open if DexScreener is unreachable.
ENABLE_MOMENTUM_GATE=true
# Fetch the Jupiter token audit per fresh candidate: hard-rejects tokens with
# >30% bot holders and enriches signals with bot % + global fees paid so the
# agent judges with the audit on-screen. Best-effort; fails open.
ENABLE_AUDIT_GATE=true
# Fetch the GMGN token snapshot per fresh candidate: smart-money/KOL holder
# counts, sniper/bundler counts, insider + bundler volume share and the dev's
# track record, attached to the signal so the agent ranks holder quality.
# Hard-rejects when insider ("rat") or bundler volume share exceeds the caps
# below — the strongest pre-rug signals available. Missing fields still pass
# (fails open). Requires a GMGN OpenAPI key (https://gmgn.ai/ai) — empty key
# disables the fetch. A cap <= 0 disables that check (enrichment stays on).
ENABLE_GMGN_GATE=true
GMGN_API_KEY=
GMGN_MAX_RAT_PCT=40
GMGN_MAX_BUNDLER_PCT=40
# Search for an established same-symbol rival token (>=500 holders, >=30 SOL
# fees, own live DLMM pool >=$5k TVL) and flag contested candidates with
# is_pvp + rival stats — ticker wars split liquidity and the copycat side
# usually loses. Advisory only (never rejects). Best-effort; fails open.
ENABLE_PVP_CHECK=true

# ─── Robinhood Chain venue (Phase 1: observe-only) ──────────────────
# Discover newly-created Uniswap v3 WETH pools on Robinhood Chain (chain ID
# 4663) via GeckoTerminal and screen them through the venue gates in
# internal/robinhood (see docs/ROBINHOOD_CHAIN_PLAN.md). Off by default.
ROBINHOOD_ENABLED=false
# Second mode (rh-mature): established pools — 24h+ old — still printing an
# outsized fee/TVL pace. Independent of ROBINHOOD_ENABLED; either mode can run
# alone. It uses its OWN discovery source (Uniswap's interface GraphQL gateway,
# keyless) because GeckoTerminal's new_pools is a launch feed and cannot see
# these pools at all. One gateway call + one GeckoTerminal enrich call per cycle.
ROBINHOOD_MATURE=false
# Third mode (rh-ladder): the weth_ladder thesis — park a one-sided WETH bid
# wall under an established pool and never buy the token. Same discovery source
# as rh-mature (Uniswap's gateway) but screens on CHURN, not yield: rh-mature's
# 8%/day bar matched only 1 of the 23 pools a profitable ladder LP actually
# worked, because a ladder has no inventory bleed to out-earn. See
# internal/robinhood.Ladder.
ROBINHOOD_LADDER=false
# Fourth mode (rh-usdg-ladder): the same one-sided bid wall, parked under the
# chain's USDG-quoted TOKENIZED EQUITIES (nvda, gme, spacex) instead of its
# memecoins. Same gateway feed as rh-ladder; different universe, so it is a
# separate mode rather than a widened one — equity books are deep, low-vol and
# sit on the 0.05% tier, printing 0.2-1.9%/day where rh-ladder demands 1.5%.
# It spends the wallet's USDG (ROBINHOOD_DEPLOY_*_USDG below), not its WETH.
ROBINHOOD_STOCK_LADDER=false
# GeckoTerminal new_pools endpoint override (empty = package default).
# Public tier: 30 req/min across all GeckoTerminal calls. Fresh mode only —
# rh-mature does not read this.
#ROBINHOOD_DISCOVER_URL=
# Dedup window for venue pool keys (rh:<mode>:<pool>).
ROBINHOOD_SEEN_TTL=6h
# Blockscout holder-count floor per candidate (fails open; 0 disables).
ROBINHOOD_MIN_HOLDERS=50
# Forward robinhood batches to the Hermes webhook. Default false = observe
# only (batches journal to the daemon log): the live subscription prompt and
# deploy pipeline only speak Solana, so EVM payloads stay out of them until
# the Phase 2 executor + prompt update land. GMGN gates reuse GMGN_API_KEY +
# the rat/bundler caps above; contract security (honeypot/blacklist/sell tax)
# hard-rejects on POSITIVE detection only (unknown still passes).
ROBINHOOD_WEBHOOK=false

# ─── Robinhood Chain deploy (Phase 2: live trading) ─────────────────
# Direct-deploy for this venue: the daemon runs uni_executor.js itself (the
# Solana DEPLOY_CMD pipeline is Solana-only and never sees EVM batches).
ROBINHOOD_DEPLOY_ENABLED=false
# Which modes may direct-deploy (comma-separated: fresh, mature, ladder,
# usdg-ladder — the Mode string minus its "rh-" prefix).
# Modes not listed still discover + screen but only journal their batches.
# "ladder" alone is the conservative setting: it keeps both token-buying modes
# observe-only and deploys only the one-sided strategy, which is what the live
# close journal argues for (see internal/config Config comment).
ROBINHOOD_DEPLOY_MODES=fresh,mature,ladder
#ROBINHOOD_EXECUTOR_CMD=node /home/ubuntu/.hermes/profiles/<profile>/skills/solana-dlmm/scripts/uni_executor.js
# v4 sibling executor (Phase 7). Unset (default) keeps v4 candidates
# observe-only: they are journaled/forwarded but excluded from deploy. Set it
# to let the deploy pick span both protocols (same wallet, same position cap).
#ROBINHOOD_V4_EXECUTOR_CMD=node /home/ubuntu/.hermes/profiles/<profile>/skills/solana-dlmm/scripts/uni_v4_executor.js
ROBINHOOD_DEPLOY_TIMEOUT=2m
# weth_ladder | balanced_tight | weth_below. A rh-usdg-ladder pick is minted as
# "usdg_ladder" automatically — same shape, USDG rungs — so this stays set to
# weth_ladder even when both ladder modes run.
# balanced_tight swaps half the commit into the memecoin before minting, so the
# position is LONG a token on a chain where tokens bleed, and every exit it took
# was a price exit rather than a fee take-profit. weth_ladder never buys the
# token; it only ever holds what the market sold it at a price we chose.
ROBINHOOD_DEPLOY_STRATEGY=weth_ladder
# Both ignored by weth_ladder (its geometry is UNI_LADDER_* below); they still
# drive balanced_tight and weth_below.
ROBINHOOD_RANGE_PCT=10
ROBINHOOD_SLIPPAGE_PCT=5
# Counted in LADDERS (funded pools), not NPM NFTs — one ladder is N rungs.
# The ladder thesis is diversification across many small books (the reference
# wallet ran 23 concurrently); 3 is a scaled-down start, not a measured optimum.
ROBINHOOD_MAX_OPEN_POSITIONS=3

# --- weth_ladder geometry (read by uni_executor.js / uni_monitor.py) ---
# Rungs per ladder and the tick width of each. Scaled down from the reference
# LP, which ran both more rungs and wider ones on a much larger ticket — the
# executor lowers the rung count further at runtime when the sized amount
# cannot fund them all, and refuses rather than mint dust.
UNI_LADDER_RUNGS=5
UNI_LADDER_RUNG_TICKS=1200
# Floor on the SMALLEST rung: below this a rung earns fees that never repay the
# gas of minting and burning it.
UNI_LADDER_MIN_RUNG_WETH=0.003
# Re-pin trigger. Ticks of price drift PAST a rung's intended offset before the
# ladder counts as stale (dead capital the market can no longer trade into).
# One rung width by default. Exits here are re-pins, not stop-losses.
UNI_LADDER_STALE_TICKS=1200
# --- usdg_ladder geometry (rh-usdg-ladder) ---
# Same three knobs, far tighter, because a tokenized equity moves 1-3% in a day
# where a memecoin moves 12% in an hour: 1200-tick rungs would park the entire
# wall out of reach and 1200 ticks of drift would mean it never re-pins.
# Widths quantize to the pool's tickSpacing, and every stock pool this mode has
# traded (SPY, TSLA, SPCX) is the 0.3% tier at spacing 60 — so these are always
# multiples of 60, and the old 120 was the narrowest rung expressible. Raised
# to 240 (four spacings, ~2.4% a rung) on 2026-08-05: the deposit floor caps a
# ~$7 commit at 3 rungs, and 3 x 120 covered only 3.6% of downside. Keep STALE
# equal to RUNG_TICKS — one rung width is the re-pin trigger.
UNI_LADDER_RUNG_TICKS_USDG=240
UNI_LADDER_STALE_TICKS_USDG=240
# Dust floor in dollars. Lower in real terms than the WETH floor because an
# equity rung will not strand on exit (the book is real and deep) — it only has
# to beat the gas of its own mint and burn. Note the executor DROPS rungs until
# the smallest clears this, so a ~$8 commit mints 2 rungs, not 5; a full
# five-rung stock ladder wants roughly $30.
UNI_LADDER_MIN_RUNG_USDG=2
# --- ladder idle exit (both quote assets) ---
# Drift and fill are PRICE rules, so a market that stops moving disarms the
# whole ladder rulebook. A usdg_ladder minted on SPY four minutes after the US
# cash close sat 5.6h with drift stuck at 56 of the 120 ticks it needed and zero
# fees on every rung — nothing broken, no rule *able* to fire. This one measures
# fee productivity instead: a rung parked out of range is 100% quote asset, so
# its quote value grows ONLY when the pool trades through the band. Below
# MIN_PCT growth across a full WINDOW, the wall is untraded — re-pin it.
# Mirrors dlmm_monitor.py's fee-pace-death rule (FEE_STALL_*); the window is
# wider because a ladder is deliberately parked off-spot, not sitting on it.
UNI_LADDER_IDLE_MIN_AGE=45
UNI_LADDER_IDLE_WINDOW=90
UNI_LADDER_IDLE_MIN_PCT=0.02
# --- Krystal Cloud position API (optional fee oracle for the rule above) ---
# Upgrades the idle rule's meter from "did the position's value move" to real
# pending+claimed fees. The chain does not give those away: tokensOwed only
# updates on poke/burn (a live rung reads 0 no matter what it earned) and
# static-calling NPM.collect costs a call per position per tick. Krystal
# answers for the whole wallet in ONE request, which is what makes a fee meter
# affordable at 60s. Also valid for an IN-RANGE rung, which value drift is not.
# Costs 10 API units per request (~14.4k/day at a 60s tick); no pagination.
# STRICTLY an enrichment: unset either key and the monitor falls back to value
# drift. No hard-risk rule (SL/TP/trailing/OOR, ladder fill and stale) ever
# consults it — a third party must not sit in the kill path.
# KRYSTAL_WALLET is the PUBLIC EVM address; this script never sees a key.
KRYSTAL_API_KEY=
KRYSTAL_WALLET=
KRYSTAL_API_URL=https://cloud-api.krystal.app/v1/positions
KRYSTAL_TIMEOUT=10
# Supertrend/RSI entry-timing gate on every deploy pick (Go port of
# local_indicators.py's supertrend_or_rsi preset — the check Solana entries
# already pass through dlmm_pipeline.py). Vetoes candidates whose token is in
# a confirmed downtrend; missing candle data fails open.
ROBINHOOD_INDICATOR_GATE=true
#
# Position sizing — dynamic, read from the live wallet before every deploy
# (robinhood.ComputeDeployAmount), the port of dlmm_pipeline.py's
# compute_deploy_amount. Replaces the old fixed ROBINHOOD_DEPLOY_AMOUNT_WETH,
# which minted a flat 0.003 WETH no matter the balance (~17% of a 0.0174 WETH
# wallet) and never scaled as the wallet grew.
#
#   deployable = weth_balance - RESERVE
#   amount     = clamp(deployable * PCT, FLOOR, CEIL)   # 0 => skip the deploy
#
# Taking a PERCENTAGE of the remaining balance is the point: each open position
# shrinks the base for the next, so exposure tapers as positions stack.
ROBINHOOD_DEPLOY_RESERVE_WETH=0.002
ROBINHOOD_DEPLOY_PCT=0.45
# Floor = smallest position worth its gas + round-trip swap cost. Below it the
# deploy is SKIPPED, not shrunk to dust.
ROBINHOOD_DEPLOY_FLOOR_WETH=0.003
# Per-position hard cap while the venue is young; raise as its close journal grows.
ROBINHOOD_DEPLOY_CEIL_WETH=0.05
# USDG-quoted pools — the v3 equity ladders and any v4 USDG pick — size off the
# wallet's USDG balance with these DOLLAR unit params (USDG has 6 decimals; the
# executor's balance output already converts). Separate from the WETH set
# because a sensible WETH floor and a sensible dollar floor are different
# numbers. FLOOR interacts with UNI_LADDER_MIN_RUNG_USDG: a commit near the
# floor mints fewer, larger rungs rather than five dust ones.
ROBINHOOD_DEPLOY_RESERVE_USDG=5
ROBINHOOD_DEPLOY_PCT_USDG=0.45
ROBINHOOD_DEPLOY_FLOOR_USDG=8
ROBINHOOD_DEPLOY_CEIL_USDG=150
# Native-ETH gas floor. This venue pays gas in ETH but LPs in WETH (unlike
# Solana, where SOL is both), so a WETH-rich wallet can still be too broke to
# mint. Fails closed below this.
ROBINHOOD_MIN_GAS_ETH=0.0002

# ─── Conviction gates ────────────────────────────────────────────────
# A cycle that produces exactly ONE fresh candidate must score at least this
# (0-100 degen score) to be emitted — "only option" is not "good option".
# Held-back pools are unmarked so they can join a future, richer batch.
# 0 disables the gate.
LONE_MIN_SCORE=50

# ─── Direct deploy (deterministic picker) ────────────────────────────
# When DEPLOY_CMD is set the daemon SKIPS the Hermes agent webhook and runs
# this command per batch with `--from-batch <payload JSON> --mode <mode>`
# appended. The pipeline re-ranks the batch deterministically (GMGN/PVP/
# prior-PnL heuristics + darwinian signal weights) and deploys the strongest
# candidate that clears every live gate, falling back to the runner-up when a
# gate rejects the pick. Decision latency drops from an LLM agent turn
# (observed 19-54 min) to seconds. Empty = webhook flow (default).
# The command is whitespace-split; paths must not contain spaces. Wallet keys
# stay in the Hermes profile .env — the executor loads them itself.
#DEPLOY_CMD=python3 /path/to/profile/skills/solana-dlmm/scripts/dlmm_pipeline.py
# Upper bound for one direct-deploy run (pre-swap + on-chain deploy).
DEPLOY_TIMEOUT=5m
# Optional delivery for direct-deploy outcome reports (text on stdin), e.g.
# `hermes send -t telegram` — no LLM, reuses the gateway's bot credentials.
# Empty = outcomes only appear in the daemon log.
#REPORT_CMD=hermes send -t telegram
# Also deliver REJECT outcomes (deploys are always delivered). Default off:
# re-signalling modes reject every few cycles and the log already has them.
REPORT_REJECTS=false
